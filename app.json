{
  "expo": {
    "name": "PSTAR & ROC-A Trainer",
    "slug": "pstar-prep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pstarprep",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orchestrsim.pstarprep",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.orchestrsim.pstarprep",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "PSTAR & ROC-A Trainer",
      "shortName": "PSTAR·ROC-A",
      "description": "Independent study app for Canada's PSTAR aviation regulations exam and the ROC-A aeronautical radio operator certificate. Not affiliated with Transport Canada or ISED. Study material based on TP 11919E (Dec 2022) and RIC-21; always verify against current CARs, RIC-21 and the TC AIM.",
      "lang": "en",
      "themeColor": "#0B2545",
      "backgroundColor": "#0B2545"
    },
    "experiments": {
      "baseUrl": "/pstar-prep"
    },
    "extra": {
      "eas": {
        "projectId": "3bd0e9f3-a693-4844-9b4e-931e482fdada"
      }
    },
    "owner": "wonmor"
  }
}
