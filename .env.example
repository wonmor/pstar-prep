# RevenueCat *public* SDK keys (Project settings → API keys → App-specific keys).
# Copy to .env.local for local builds, and add to EAS: `eas env:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY ...`
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx
# QA / screenshots only: force Pro on native builds. Never set for store builds.
# EXPO_PUBLIC_FORCE_PRO=1
