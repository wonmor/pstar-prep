  "questions": [
    {
      "id": "1.01",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "A Restricted Operator Certificate (Aeronautical) is:",
      "options": [
        "Valid for five years",
        "Issued for life, with no revalidation required",
        "Valid until the holder turns 60",
        "Renewed each year"
      ],
      "answer": 2,
      "reference": "RIC-21 §1 — Intent"
    },
    {
      "id": "1.02",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "An ROC-A is required by:",
      "options": [
        "Passengers on commercial flights",
        "Operators of radiotelephone equipment on aircraft and at aeronautical land stations using aeronautical mobile frequencies",
        "Air traffic controllers only",
        "Aircraft maintenance engineers"
      ],
      "answer": 2,
      "reference": "RIC-21 §2 — Background"
    },
    {
      "id": "1.03",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "For ROC-A purposes, the radiotelephone equipment must have a power output not exceeding:",
      "options": [
        "5 watts",
        "50 watts",
        "250 watts e.r.p. (400 watts PEP)",
        "1000 watts"
      ],
      "answer": 3,
      "reference": "RIC-21 §2 — Background"
    },
    {
      "id": "1.04",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "ROC-A examinations are conducted by:",
      "options": [
        "Transport Canada inspectors",
        "NAV CANADA staff",
        "Examiners accredited by ISED (Industry Canada)",
        "Any licensed pilot"
      ],
      "answer": 3,
      "reference": "RIC-21 §3.1 — Exam"
    },
    {
      "id": "1.05",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "Regarding who may hold an ROC-A, there are:",
      "options": [
        "Minimum age and citizenship requirements",
        "No nationality or age restrictions",
        "Medical requirements identical to a pilot licence",
        "A requirement to hold a pilot permit first"
      ],
      "answer": 2,
      "reference": "RIC-21 §3.2 — Eligibility"
    },
    {
      "id": "1.06",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "The operation of an aircraft radio station is under the control of:",
      "options": [
        "The nearest control tower at all times",
        "The most senior passenger",
        "The pilot or other person in charge of the station",
        "ISED"
      ],
      "answer": 3,
      "reference": "RIC-21 §4.3 — Control of Communications"
    },
    {
      "id": "1.07",
      "section": 1,
      "sectionName": "Certificate & Background",
      "question": "If your ROC-A certificate is lost, you should:",
      "options": [
        "Re-sit the entire examination",
        "Contact the district office / Radio Operator Certificate Service Centre for a replacement",
        "Apply to Transport Canada",
        "Do nothing — it cannot be replaced"
      ],
      "answer": 2,
      "reference": "RIC-21 §1 / Appendix F"
    },
    {
      "id": "2.01",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "In the aeronautical service, the highest priority of communication is:",
      "options": [
        "Flight regularity messages",
        "Meteorological messages",
        "Distress communications",
        "Direction-finding communications"
      ],
      "answer": 3,
      "reference": "RIC-21 §4.1 — Priorities of Communications"
    },
    {
      "id": "2.02",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "In the order of priority, urgency communications rank:",
      "options": [
        "First",
        "Second, immediately after distress",
        "Last",
        "Equal with weather messages"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.1 — Priorities of Communications"
    },
    {
      "id": "2.03",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "In the priority list, communications relating to radio direction-finding rank:",
      "options": [
        "Above distress",
        "Third — after distress and urgency",
        "Below all other messages",
        "They are prohibited"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.1 — Priorities of Communications"
    },
    {
      "id": "2.04",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "Radio operators and anyone who overhears radiocommunications are:",
      "options": [
        "Free to share them publicly",
        "Bound to preserve the privacy of those communications",
        "Required to record them",
        "Permitted to sell them"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.2 — Privacy of Communications"
    },
    {
      "id": "2.05",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "The privacy-of-communications rule does NOT apply to:",
      "options": [
        "Routine position reports",
        "Company traffic",
        "Messages of distress, urgency, safety, or those addressed to “ALL STATIONS”",
        "Clearance read-backs"
      ],
      "answer": 3,
      "reference": "RIC-21 §4.2 — Privacy of Communications"
    },
    {
      "id": "2.06",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "Between an aeronautical ground station and an aircraft station, communications control is normally retained by:",
      "options": [
        "The aircraft station",
        "The ground station",
        "Whichever transmits first",
        "The busier station"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.3 — Control of Communications"
    },
    {
      "id": "2.07",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "In communications between two aircraft stations, the controlling station is:",
      "options": [
        "The aircraft being called",
        "The aircraft calling",
        "The higher-flying aircraft",
        "Neither"
      ],
      "answer": 1,
      "reference": "RIC-21 §4.3 — Control of Communications"
    },
    {
      "id": "2.08",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "Superfluous communication and profane or obscene language on aeronautical frequencies are:",
      "options": [
        "Permitted when the frequency is quiet",
        "Strictly prohibited",
        "Allowed between company aircraft",
        "Allowed in an emergency"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.4 — Superfluous Communications (Radiocommunication Regulations s.32(1))"
    },
    {
      "id": "2.09",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "You may deliberately interfere with another station's working only when:",
      "options": [
        "The frequency is congested",
        "You must transmit a higher-priority call such as distress or urgency",
        "You are in a hurry",
        "Never — under any circumstances"
      ],
      "answer": 2,
      "reference": "RIC-21 §4.4 — Superfluous Communications and Interference"
    },
    {
      "id": "2.10",
      "section": 2,
      "sectionName": "Regulations & Priorities",
      "question": "Knowingly transmitting a false or fraudulent distress signal is:",
      "options": [
        "A minor rule infraction",
        "Permitted for practice",
        "An offence under the Radiocommunication Act with substantial penalties",
        "Allowed if cancelled afterward"
      ],
      "answer": 3,
      "reference": "RIC-21 §4.5 — False Distress Signals (Act 9(1)(a))"
    },
