    {
      "id": "5.01",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"ROGER\" means:",
      "options": [
        "Yes, that is correct",
        "I have received all of your last transmission",
        "I will comply",
        "Say again"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.02",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"WILCO\" means:",
      "options": [
        "Will continue",
        "Your instructions are received, understood and will be complied with",
        "Wait one minute",
        "Wrong — correcting"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.03",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"AFFIRM\" means:",
      "options": [
        "No",
        "Yes",
        "Maybe",
        "Standby"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.04",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"NEGATIVE\" means:",
      "options": [
        "Go ahead",
        "No, or that is not correct",
        "Message received",
        "Out"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.05",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"OVER\" means:",
      "options": [
        "Conversation ended, no reply expected",
        "My transmission is ended and I expect a response from you",
        "Change frequency",
        "Repeat your message"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.06",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"OUT\" means:",
      "options": [
        "Go ahead",
        "Conversation is ended and no response is expected",
        "Standby",
        "I am in distress"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.07",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"STANDBY\" means:",
      "options": [
        "Proceed with your message",
        "I must pause; please wait and I will call you",
        "Message not received",
        "Cancel the message"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.08",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"DISREGARD\" means:",
      "options": [
        "Repeat the message",
        "Consider this transmission as not sent",
        "Message understood",
        "Increase power"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.09",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"SAY AGAIN\" is used to:",
      "options": [
        "End the conversation",
        "Request a repetition of the last transmission",
        "Confirm receipt",
        "Acknowledge an error"
