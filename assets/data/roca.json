      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.10",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"MONITOR\" means:",
      "options": [
        "Transmit continuously",
        "Listen (on frequency)",
        "Record the transmission",
        "Reduce volume"
      ],
      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.11",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"WORDS TWICE\" means:",
      "options": [
        "Speak twice as fast",
        "Because communication is difficult, send each word or group of words twice",
        "Repeat only the call sign",
        "Double the transmitter power"
