      "answer": 2,
      "reference": "RIC-21 Appendix B — Procedural Words"
    },
    {
      "id": "5.12",
      "section": 5,
      "sectionName": "Procedural Words & Phrases",
      "question": "\"CORRECTION\" is used when:",
